{
    "manifest_version" : 3,
    "name" : "auto copy" ,
    "description" : "Automatically copies selected text to the clipboard",
    "version" : "1.0.0" ,

    "permissions" : [ "storage", "clipboardWrite" ] ,
     "host_permissions" : [ "<all_urls>" ] ,

    "background": {
    "service_worker": "background.js"
    },

    "content_scripts": [
        {
        "matches": ["<all_urls>"],
        "js": ["utils/constants.js","utils/storage.js", "utils/clipboard.js", "utils/debounce.js", "utils/popup.js", "content/content.js"],
        "css": ["styles/popup.css"],
        "run_at": "document_idle"
        }
    ],

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Auto Copy"
    }

}